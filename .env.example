# Энэ файлыг .env нэрээр хуулж, жинхэнэ токеноо зөвхөн .env дотор оруулна.
BYL_TOKEN=
BYL_PROJECT_ID=852
BYL_PRICE_LOOKUP_KEY=modelY_price
BYL_PRODUCT_ID=1651

# Сонголттой. Тохируулаагүй үед одоогийн deployment URL автоматаар ашиглагдана.
APP_URL=http://localhost:3000

# Supabase Auth — browser-т зөвхөн publishable key очно.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Зөвшөөрөгдсөн ганц админ. ADMIN_USER_ID-г Supabase Auth хэрэглэгчийн UUID-аар тохируулна.
ADMIN_EMAIL=zulamula.88@gmail.com
ADMIN_USER_ID=
